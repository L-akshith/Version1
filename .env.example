# ExamShield Application Environment Configuration Example
#
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO GIT.

# ── Application ──────────────────────────────────────────────
APP_NAME="ExamShield"
APP_VERSION="1.0.0"
ENVIRONMENT="staging" # "development", "staging", "production"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# ── Database (Railway PostgreSQL / AWS RDS) ──────────────────
# Railway PostgreSQL URL format: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL="postgresql+asyncpg://examshield:examshield@localhost:5432/examshield"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET_KEY="GENERATE-A-SECURE-256-BIT-RANDOM-SECRET-FOR-STAGING-OR-PROD"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ─────────────────────────────────────────────────────
# Origins allowed to make API requests (e.g. Netlify frontend)
CORS_ORIGINS=["https://examshield.netlify.app", "http://localhost:3000", "http://localhost:5173"]

# ── Security & Cryptography Providers ───────────────────────
CRYPTO_PROVIDER="local" # "local" for dev/staging, "kms" for AWS production
STORAGE_PROVIDER="local" # "local" for dev/staging filesystem, "s3" for AWS production
LOCAL_KEYS_DIR="/app/data/.local_keys" # Mount persistent volume at /app/data on Railway staging
UPLOAD_DIR="/app/data/uploads" # Mount persistent volume at /app/data on Railway staging

# ── AWS Infrastructure (Only when CRYPTO_PROVIDER=kms or STORAGE_PROVIDER=s3) ──
AWS_REGION="us-east-1"
AWS_KMS_KEY_ID="arn:aws:kms:us-east-1:123456789012:key/your-kms-key-id"
S3_BUCKET="examshield-question-papers-prod"
S3_PREFIX="question_papers"

# ── Initial Bootstrap Superuser ──────────────────────────────
FIRST_SUPERUSER_EMAIL="admin@examshield.gov.in"
FIRST_SUPERUSER_PASSWORD="ChangeThisPassword123!"
FIRST_SUPERUSER_FULL_NAME="System Administrator"

# ── Netlify Frontend Environment Variable ─────────────────────
# VITE_API_URL="https://examshield-api.up.railway.app"
