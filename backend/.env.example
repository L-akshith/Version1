# ── Application Configuration ────────────────────────────────────
APP_NAME=ExamShield
APP_VERSION=1.0.0
APP_DESCRIPTION="Secure Examination Paper Management and Distribution Platform"
DEBUG=true
ENVIRONMENT=development

# ── Server Configuration ─────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database Configuration ───────────────────────────────────────
# Default development postgres configuration
DATABASE_URL=postgresql+asyncpg://examshield:examshield@db:5432/examshield
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Security Configuration ───────────────────────────────────────
# Change this to a secure long random value in production: openssl rand -hex 32
JWT_SECRET_KEY=94bc9bf9b59637c355f32eb4a79c94519962a1db3d548f020bc8b60098dfc38f
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── Redis Configuration (Optional) ───────────────────────────────
# REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=examshield:

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── First Superuser Account ──────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@examshield.gov.in
FIRST_SUPERUSER_PASSWORD=ChangeThisPassword123!
FIRST_SUPERUSER_FULL_NAME="System Administrator"
